meta {
  name: Get user
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/users/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test("get user returns 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.be.a("number");
  });
}
