meta {
  name: Register invalid user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "not-an-email",
    "password": "short"
  }
}

tests {
  test("invalid registration returns 400", function() {
    expect(res.status).to.equal(400);
    expect(res.body.status).to.equal(400);
  });
}
