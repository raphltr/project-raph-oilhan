meta {
  name: Register user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "bruno-user@example.com",
    "password": "password123"
  }
}

tests {
  test("user registration returns 201", function() {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("number");
    expect(res.body.email).to.equal("bruno-user@example.com");
  });
}
