meta {
  name: Update user
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "updated-bruno-user@example.com"
  }
}

tests {
  test("update user returns 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.be.a("number");
  });
}
