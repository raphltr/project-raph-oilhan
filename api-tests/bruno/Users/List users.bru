meta {
  name: List users
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/users?page=1&pageSize=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("user list returns a page", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.page).to.equal(1);
    expect(res.body.pageSize).to.equal(20);
  });
}
