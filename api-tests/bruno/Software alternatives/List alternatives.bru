meta {
  name: List alternatives
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/software-alternatives?page=1&pageSize=20&taskId={{taskId}}&status=approved
  body: none
  auth: none
}

tests {
  test("alternative list returns a page", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.page).to.equal(1);
    expect(res.body.pageSize).to.equal(20);
  });
}
