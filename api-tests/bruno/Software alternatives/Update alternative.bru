meta {
  name: Update alternative
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/software-alternatives/{{pendingAlternativeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "description": "Updated description from Bruno."
  }
}

tests {
  test("alternative update returns 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.be.a("number");
  });
}
