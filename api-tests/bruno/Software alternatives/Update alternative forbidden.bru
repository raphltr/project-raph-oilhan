meta {
  name: Update alternative forbidden
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/api/software-alternatives/{{otherAlternativeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

headers {
